---
import type { FeatureValue } from "../lib/schema.ts";
interface Props { value: FeatureValue | undefined; note?: string; size?: "sm" | "md" }
const { value, note, size = "md" } = Astro.props;
const map = {
  yes: { sym: "✓", label: "Supported", cls: "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300" },
  no: { sym: "✕", label: "Not supported", cls: "bg-zinc-100 text-zinc-400 dark:bg-zinc-800 dark:text-zinc-500" },
  partial: { sym: "◐", label: "Partial", cls: "bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300" },
  addon: { sym: "+", label: "Paid add-on or tier", cls: "bg-sky-100 text-sky-700 dark:bg-sky-500/15 dark:text-sky-300" },
  unknown: { sym: "?", label: "Unknown", cls: "bg-transparent text-zinc-400 ring-1 ring-inset ring-zinc-200 dark:ring-zinc-700" },
};
const key = value === true ? "yes" : value === false ? "no" : value === "partial" ? "partial" : value === "addon" ? "addon" : "unknown";
const m = map[key];
---
<span
  class="inline-flex cursor-default items-center gap-1.5 rounded-full outline-offset-2"
  data-tip={m.label}
  data-tip-note={note}
  data-tip-tone={key}
  tabindex={note ? 0 : undefined}
>
  <span class:list={["inline-flex items-center justify-center rounded-full font-bold", size === "sm" ? "size-5 text-[10px]" : "size-6 text-xs", m.cls]} aria-hidden="true">{m.sym}</span>
  <span class="sr-only">{note ? `${m.label}: ${note}` : m.label}</span>
  {note && <span class="text-zinc-400" aria-hidden="true">*</span>}
</span>
