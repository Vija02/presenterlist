---
import { initial, type P } from "../lib/products.ts";
interface Props { product: P; size?: "sm" | "md" | "lg" }
const { product, size = "md" } = Astro.props;
const dims = { sm: "size-8 text-sm", md: "size-11 text-lg", lg: "size-16 text-2xl" }[size];
---
{
  product.logo ? (
    <span class:list={[dims, "inline-flex shrink-0 items-center justify-center overflow-hidden rounded-lg bg-white p-1 ring-1 ring-inset ring-zinc-200 dark:ring-zinc-700"]}>
      <img src={product.logo} alt={`${product.name} logo`} class="size-full object-contain" loading="lazy" decoding="async" />
    </span>
  ) : (
    <span
      aria-hidden="true"
      class:list={[
        dims,
        "inline-flex shrink-0 items-center justify-center rounded-lg bg-zinc-100 font-semibold text-zinc-700 ring-1 ring-inset ring-zinc-200 dark:bg-zinc-800 dark:text-zinc-200 dark:ring-zinc-700",
      ]}
    >
      {initial(product.name)}
    </span>
  )
}
