---
// One shared tooltip for any element with data-tip (and optional data-tip-note / data-tip-tone).
// Rendered on <body> with fixed positioning so scroll containers can't clip it.
---
<div id="tip" role="tooltip" aria-hidden="true" data-side="top">
  <div class="tip-head"><span class="tip-dot"></span><span class="tip-label"></span></div>
  <div class="tip-note"></div>
  <span class="tip-arrow"></span>
</div>

<style is:global>
  #tip {
    position: fixed;
    z-index: 60;
    left: 0;
    top: 0;
    max-width: min(18rem, calc(100vw - 16px));
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    background: #18181b;
    color: #f4f4f5;
    font-size: 0.75rem;
    line-height: 1.35;
    box-shadow: 0 8px 24px -6px rgb(0 0 0 / 0.35), 0 0 0 1px rgb(255 255 255 / 0.06) inset;
    pointer-events: none;
    opacity: 0;
    transform: translateY(var(--tip-shift, 4px)) scale(0.97);
    transition: opacity 90ms ease-out, transform 90ms ease-out;
  }
  #tip[data-side="bottom"] { --tip-shift: -4px; }
  #tip.is-open { opacity: 1; transform: none; }
  :root.dark #tip { background: #fafafa; color: #18181b; box-shadow: 0 8px 24px -6px rgb(0 0 0 / 0.6); }
  #tip .tip-head { display: flex; align-items: center; gap: 0.4rem; font-weight: 600; }
  #tip .tip-dot { width: 0.5rem; height: 0.5rem; border-radius: 9999px; flex: none; background: #a1a1aa; }
  #tip[data-tone="yes"] .tip-dot { background: #34d399; }
  #tip[data-tone="partial"] .tip-dot { background: #fbbf24; }
  #tip[data-tone="addon"] .tip-dot { background: #38bdf8; }
  #tip[data-tone="no"] .tip-dot { background: #71717a; }
  #tip[data-tone="unknown"] .tip-dot { background: transparent; box-shadow: inset 0 0 0 1.5px #a1a1aa; }
  #tip .tip-note { margin-top: 0.25rem; color: #d4d4d8; }
  :root.dark #tip .tip-note { color: #52525b; }
  #tip .tip-note:empty { display: none; }
  #tip .tip-arrow {
    position: absolute;
    left: var(--tip-arrow-x, 50%);
    width: 0.5rem;
    height: 0.5rem;
    background: inherit;
    transform: translateX(-50%) rotate(45deg);
  }
  #tip[data-side="top"] .tip-arrow { bottom: -0.25rem; }
  #tip[data-side="bottom"] .tip-arrow { top: -0.25rem; }
  @media (prefers-reduced-motion: reduce) { #tip { transition: none; } }
</style>

<script>
  const tip = document.getElementById("tip")!;
  const label = tip.querySelector<HTMLElement>(".tip-label")!;
  const note = tip.querySelector<HTMLElement>(".tip-note")!;
  let current: HTMLElement | null = null;
  let timer: number | undefined;

  function place(el: HTMLElement) {
    const r = el.getBoundingClientRect();
    const t = tip.getBoundingClientRect();
    const gap = 8;
    const side = r.top - t.height - gap < 8 ? "bottom" : "top";
    const cx = r.left + r.width / 2;
    const left = Math.min(Math.max(8, cx - t.width / 2), window.innerWidth - t.width - 8);
    const top = side === "top" ? r.top - t.height - gap : r.bottom + gap;
    tip.dataset.side = side;
    tip.style.setProperty("--tip-arrow-x", `${Math.min(Math.max(10, cx - left), t.width - 10)}px`);
    tip.style.left = `${Math.round(left)}px`;
    tip.style.top = `${Math.round(top)}px`;
  }

  function show(el: HTMLElement) {
    clearTimeout(timer);
    current = el;
    label.textContent = el.dataset.tip ?? "";
    note.textContent = el.dataset.tipNote ?? "";
    tip.dataset.tone = el.dataset.tipTone ?? "";
    tip.classList.remove("is-open");
    tip.style.left = "0px";
    tip.style.top = "0px";
    place(el);
    timer = window.setTimeout(() => tip.classList.add("is-open"), 40);
  }

  function hide() {
    clearTimeout(timer);
    current = null;
    tip.classList.remove("is-open");
  }

  const target = (e: Event) => (e.target as Element | null)?.closest?.<HTMLElement>("[data-tip]") ?? null;

  document.addEventListener("pointerover", (e) => {
    if (e.pointerType === "touch") return;
    const el = target(e);
    if (el && el !== current) show(el);
  });
  document.addEventListener("pointerout", (e) => {
    if (e.pointerType === "touch") return;
    const el = target(e);
    if (el && !el.contains(e.relatedTarget as Node)) hide();
  });
  document.addEventListener("focusin", (e) => {
    const el = target(e);
    if (el) show(el);
  });
  document.addEventListener("focusout", hide);
  // Touch: tap to toggle, tap elsewhere to close.
  document.addEventListener("click", (e) => {
    const el = target(e);
    if (el && el !== current) show(el);
    else hide();
  });
  document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  window.addEventListener("scroll", () => current && place(current), { passive: true, capture: true });
  window.addEventListener("resize", hide);
</script>
