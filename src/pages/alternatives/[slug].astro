---
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import Badges from "../../components/Badges.astro";
import { FEATURE_PATHS } from "../../lib/schema.ts";
import { alternativesFor, feat, featureFullLabel, fullySupports, getProducts, isFree, pairSlug, platformLabel, priceSummary, type P } from "../../lib/products.ts";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props as { product: P };
const all = await getProducts();
const alts = alternativesFor(p, all).filter((x) => x.status !== "discontinued");

const highlights = (x: P) => {
  const h: string[] = [];
  if (x.open_source && !p.open_source) h.push("Open source");
  if (isFree(x) && !isFree(p)) h.push("Free");
  const extraPlatforms = x.platforms.filter((k) => !p.platforms.includes(k)).map(platformLabel);
  if (extraPlatforms.length) h.push(`Also runs on ${extraPlatforms.join(", ")}`);
  const extra = FEATURE_PATHS.filter((k) => fullySupports(x, k) && feat(p, k) === false).map(featureFullLabel);
  h.push(...extra.slice(0, 4));
  return h;
};
const title = `${p.name} alternatives`;
---
<Base
  title={`${alts.length} best ${title} for churches`}
  description={`Looking for an alternative to ${p.name}? Compare ${alts.length} church presentation tools by price, platform and features.`}
  breadcrumbs={[{ label: p.name, href: `/software/${p.slug}/` }, { label: "Alternatives" }]}
>
  <div class="container-page mt-6 max-w-4xl">
    <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
    <p class="mt-2 text-zinc-600 dark:text-zinc-400">
      {alts.length} active alternatives to <a href={`/software/${p.slug}/`} class="link">{p.name}</a>, ranked by how closely their
      platforms and features overlap. Highlights show where an alternative differs from {p.name}.
    </p>
    <ol class="mt-8 space-y-4">
      {alts.map((x, i) => {
        const h = highlights(x);
        return (
          <li class="card p-5">
            <div class="flex items-start gap-4">
              <span class="w-6 shrink-0 pt-2 text-right text-sm text-zinc-400">{i + 1}.</span>
              <Logo product={x} />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h2 class="text-lg font-semibold"><a href={`/software/${x.slug}/`} class="hover:underline">{x.name}</a></h2>
                  <span class="text-sm text-zinc-500">{priceSummary(x)}</span>
                </div>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{x.tagline}</p>
                <Badges product={x} class="mt-2" />
                {h.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-1.5">
                    {h.map((t) => <li class="rounded-md bg-emerald-50 px-2 py-0.5 text-xs text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-300">+ {t}</li>)}
                  </ul>
                )}
                <p class="mt-3 text-sm"><a href={`/compare/${pairSlug(p.slug, x.slug)}/`} class="link">{p.name} vs {x.name} →</a></p>
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</Base>
