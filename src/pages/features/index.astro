---
import Base from "../../layouts/Base.astro";
import { FEATURE_GROUPS, subKeys } from "../../lib/schema.ts";
import { featureLabel, featureSlug, getProducts, supports } from "../../lib/products.ts";
const products = (await getProducts()).filter((p) => p.status !== "discontinued");
const count = (path: string) => products.filter((p) => supports(p, path)).length;
---
<Base title="Church presentation software by feature" description="Find church presentation software that supports PowerPoint, Canva, Planning Center, CCLI SongSelect, NDI, bilingual lyrics, stage displays and more." breadcrumbs={[{ label: "Features" }]}>
  <div class="container-page mt-6">
    <h1 class="text-3xl font-bold tracking-tight">Browse by feature</h1>
    <p class="mt-2 text-zinc-600 dark:text-zinc-400">Counts include active products with confirmed (full, partial or add-on) support.</p>
    <div class="mt-8 gap-6 md:columns-2 xl:columns-3">
      {Object.values(FEATURE_GROUPS).map((g) => (
        <section class="card mb-6 break-inside-avoid p-5">
          <h2 class="mb-3 font-semibold">{g.label}</h2>
          <ul class="space-y-3 text-sm">
            {Object.keys(g.features).map((k) => (
              <li>
                <div class="flex justify-between gap-3">
                  <a href={`/features/${featureSlug(k)}/`} class="link">{featureLabel(k)}</a>
                  <span class="text-zinc-400">{count(k)}</span>
                </div>
                {subKeys(k).length > 0 && (
                  <ul class="mt-1.5 space-y-1 border-l border-zinc-200 pl-3 text-xs dark:border-zinc-800">
                    {subKeys(k).map((s) => (
                      <li class="flex justify-between gap-3">
                        <a href={`/features/${featureSlug(`${k}.${s}`)}/`} class="text-zinc-600 hover:underline dark:text-zinc-400">{featureLabel(`${k}.${s}`)}</a>
                        <span class="text-zinc-400">{count(`${k}.${s}`)}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
