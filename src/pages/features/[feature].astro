---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { FEATURE_KEYS, FEATURES, type FeatureKey } from "../../lib/schema.ts";
import { featureSlug, getProducts } from "../../lib/products.ts";

export function getStaticPaths() {
  return FEATURE_KEYS.map((k) => ({ params: { feature: featureSlug(k) }, props: { key: k } }));
}
const { key } = Astro.props as { key: FeatureKey };
const label = FEATURES[key];
const products = (await getProducts()).filter((p) => p.status !== "discontinued");
const groups = [
  { title: "Supported", items: products.filter((p) => p.features?.[key] === true) },
  { title: "Partial support", items: products.filter((p) => p.features?.[key] === "partial") },
  { title: "Via paid add-on or higher tier", items: products.filter((p) => p.features?.[key] === "addon") },
];
const unknown = products.filter((p) => p.features?.[key] === undefined);
---
<Base title={`Church presentation software with ${label.toLowerCase()}`} description={`Church presentation software that supports ${label.toLowerCase()}.`} breadcrumbs={[{ label: "Features", href: "/features/" }, { label }]}>
  <div class="container-page mt-6">
    <h1 class="text-3xl font-bold tracking-tight">{label}</h1>
    <p class="mt-2 text-zinc-600 dark:text-zinc-400">Active church presentation software with {label.toLowerCase()}.</p>
    {groups.filter((g) => g.items.length).map((g) => (
      <section class="mt-10">
        <h2 class="h-section">{g.title} <span class="font-normal text-zinc-400">({g.items.length})</span></h2>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{g.items.map((p) => <ProductCard product={p} />)}</ul>
      </section>
    ))}
    {groups.every((g) => !g.items.length) && <p class="mt-10 text-zinc-500">No products are confirmed to support this yet.</p>}
    {unknown.length > 0 && (
      <p class="mt-10 text-sm text-zinc-500">
        Unknown for: {unknown.map((p, i) => <>{i > 0 && ", "}<a href={`/software/${p.slug}/`} class="link">{p.name}</a></>)}. Know the answer?
        <a href="/about/#contribute" class="link">Help us fill it in.</a>
      </p>
    )}
  </div>
</Base>
