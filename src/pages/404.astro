---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found">
  <div class="container-page py-24 text-center">
    <p class="text-sm font-semibold text-brand-600">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">That page doesn't exist. It may have been renamed.</p>
    <a href="/" class="btn-primary mt-8">Back to the directory</a>
  </div>
</Base>
